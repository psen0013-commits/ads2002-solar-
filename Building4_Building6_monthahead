    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import display\n",
    "\n",
    "OUT = Path(r'C:\\Users\\50851\\Documents\\Codex\\2026-08-14\\kan\\outputs\\building46_monthahead')\n",
    "scores = pd.read_csv(OUT / 'all_month_scores.csv')\n",
    "validation = scores[scores.Month.isin(['Jun', 'Jul', 'Aug', 'Sep'])]\n",
    "rmse_selection = validation.groupby(['Building', 'Model']).RMSE.mean()\n",
    "chosen = {b: rmse_selection.loc[b].idxmin() for b in ['Building4', 'Building6']}\n",
    "months = ['Oct', 'Nov']\n",
    "colors = {'Reference GB': '#777777', 'RMSE-selected': '#316b9b'}\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 8), layout='constrained')\n",
    "comparison = []\n",
    "for i, building in enumerate(['Building4', 'Building6']):\n",
    "    for j, metric in enumerate(['R2', 'RMSE']):\n",
    "        ax = axes[i, j]\n",
    "        for k, (label, model) in enumerate([('Reference GB', 'Reference GB'), ('RMSE-selected', chosen[building])]):\n",
    "            z = scores[(scores.Building == building) & (scores.Model == model)].set_index('Month').loc[months]\n",
    "            bars = ax.bar(np.arange(2)+(k-.5)*.34, z[metric], width=.34,\n",
    "                          color=colors[label], label=label, hatch='//' if k == 0 else None)\n",
    "            ax.bar_label(bars, fmt='%.4f', padding=3, fontsize=10)\n",
    "        ax.set_xticks([0,1], ['October 2020', 'November 2020'])\n",
    "        ax.set_ylabel('R² (higher is better)' if metric == 'R2' else 'RMSE (kW; lower is better)')\n",
    "        ax.set_title(building + ': ' + chosen[building])\n",
    "        ax.set_ylim(bottom=0)\n",
    "        lo, hi = ax.get_ylim(); ax.set_ylim(lo, hi * 1.22)\n",
    "        ax.legend(loc='upper left', fontsize=9)\n",
    "    for month in months:\n",
    "        part = scores[(scores.Building == building) & (scores.Month == month)].set_index('Model')\n",
    "        a, b = part.loc['Reference GB'], part.loc[chosen[building]]\n",
    "        comparison.append(dict(Building=building, Month=month, Selected_model=chosen[building],\n",
    "                               Reference_R2=a.R2, Selected_R2=b.R2, R2_change=b.R2-a.R2,\n",
    "                               Reference_RMSE=a.RMSE, Selected_RMSE=b.RMSE,\n",
    "                               RMSE_reduction_pct=100*(a.RMSE-b.RMSE)/a.RMSE,\n",
    "                               MASE_reduction_pct=100*(a.MASE-b.MASE)/a.MASE))\n",
    "fig.suptitle('Same-protocol comparison on observed 15-minute targets', fontsize=14)\n",
    "fig.savefig(OUT / 'performance_comparison.png', dpi=150)\n",
    "plt.show()\n",
    "comparison = pd.DataFrame(comparison)\n",
    "display(comparison.round(4))\n",
    "comparison.to_csv(OUT / 'performance_improvement.csv', index=False)\n",
    "\n",
    "# Display every candidate without choosing a winner using test-month results.\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 9), layout='constrained', sharey=True)\n",
    "models = sorted(scores.Model.unique())\n",
    "for ax, building in zip(axes, ['Building4', 'Building6']):\n",
    "    for k, (month, color) in enumerate([('Oct', '#316b9b'), ('Nov', '#ba8520')]):\n",
    "        z = scores[(scores.Building == building) & (scores.Month == month)].set_index('Model').loc[models]\n",
    "        bars=ax.barh(np.arange(len(models))+(k-.5)*.36, z.R2, height=.36,\n",
    "                     color=color, label=month+' 2020', hatch='//' if k else None)\n",
    "        ax.bar_label(bars, fmt='%.3f', padding=3, fontsize=9)\n",
    "    ax.set_yticks(np.arange(len(models)), models)\n",
    "    ax.invert_yaxis(); ax.axvline(0, color='#333333', linewidth=.8)\n",
    "    ax.set_title(building); ax.set_xlabel('R² (higher is better; not percentage accuracy)')\n",
    "    ax.margins(x=.22); ax.legend(loc='lower right')\n",
    "fig.suptitle('All candidate models: October–November 2020 historical evaluation', fontsize=14)\n",
    "fig.savefig(OUT / 'all_models_r2.png', dpi=150)\n",
    "plt.show()\n"
   ]
