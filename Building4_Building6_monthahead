   "source": [
    "import matplotlib.dates as mdates\n",
    "from pathlib import Path\n",
    "import numpy as np,pandas as pd,matplotlib.pyplot as plt\n",
    "from IPython.display import display\n",
    "OUT=Path(r'C:\\Users\\50851\\Documents\\Codex\\2026-08-14\\kan\\outputs\\building46_monthahead')\n",
    "scores=pd.read_csv(OUT/'all_month_scores.csv')\n",
    "forecast=pd.read_csv(OUT/'all_model_forecasts_15min.csv',parse_dates=['timestamp_UTC'])\n",
    "forecast['timestamp_UTC']=pd.to_datetime(forecast.timestamp_UTC,utc=True)\n",
    "selection=scores[scores.Month.isin(['Jun','Jul','Aug','Sep'])].groupby(['Building','Model'])[['MASE','RMSE']].mean()\n",
    "dual=[];daily=[]\n",
    "for b in ['Building4','Building6']:\n",
    "    for objective in ['MASE','RMSE']:\n",
    "        name=selection.loc[b,objective].idxmin()\n",
    "        for mon in ['Oct','Nov']:\n",
    "            row=scores[(scores.Building==b)&(scores.Month==mon)&(scores.Model==name)].iloc[0]\n",
    "            dual.append({'Selection_objective':objective,**row.to_dict()})\n",
    "            z=forecast[(forecast.Building==b)&(forecast.Month==mon)&(forecast.Model==name)].copy()\n",
    "            expected=2976 if mon=='Oct' else 2880\n",
    "            assert len(z)==expected and not z.timestamp_UTC.duplicated().any()\n",
    "            assert z.predicted_kW.notna().all() and (z.predicted_kW>=0).all()\n",
    "            assert z.timestamp_UTC.diff().dropna().eq(pd.Timedelta(minutes=15)).all()\n",
    "            # Independently reconcile saved MAE/RMSE with forecast errors.\n",
    "            err=(z.predicted_kW-z.actual_kW).dropna()\n",
    "            assert np.isclose(err.abs().mean(),row.MAE) and np.isclose(np.sqrt((err**2).mean()),row.RMSE)\n",
    "            z['predicted_kWh']=z.predicted_kW*.25\n",
    "            z['Selection_objective']=objective\n",
    "            if objective=='RMSE':z.to_csv(OUT/f'{b}_{mon}_RMSE_selected_forecast.csv',index=False)\n",
    "            d=z.set_index('timestamp_UTC').resample('D').agg(predicted_kWh=('predicted_kWh','sum'),observed_slots=('actual_kW','count'))\n",
    "            d['Building']=b;d['Month']=mon;d['Selection_objective']=objective;d['Model']=name\n",
    "            assert np.isclose(d.predicted_kWh.sum(),z.predicted_kWh.sum())\n",
    "            daily.append(d.reset_index())\n",
    "dual=pd.DataFrame(dual);daily=pd.concat(daily,ignore_index=True)\n",
    "display(dual[['Selection_objective','Building','Month','Model','MASE','RMSE','R2','Within10pct']].round(4))\n",
